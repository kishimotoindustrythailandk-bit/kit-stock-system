{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ต้องตรงกับ Worker ที่ให้บริการอยู่จริงเท่านั้น
  // เดิมเป็น "kit-stock" ซึ่งไม่มี Worker ชื่อนี้อยู่บน account เลย
  // ใครเช็คเอาต์รีโปแล้วสั่ง npm run deploy จะได้ Worker ตัวใหม่ที่ผูก
  // D1 production ตัวเดียวกัน กลายเป็นสองระบบเขียนฐานเดียวโดยไม่มีใครรู้
  "name": "kit-stock-system",
  "account_id": "62a2ea38f1cd68495040944279373469",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kit-stock-db",
      "database_id": "501d0e19-8572-4a8c-ad19-1d2b1346d7d9",
      // migrations/ คือชุดเดียวที่ใช้จริง ตรงกับ out ใน drizzle.config.ts
      // เดิมชี้ไปที่ drizzle/ ซึ่งเป็นสาขาที่เลิกใช้แล้ว (auth รุ่น employees)
      // ทำให้ migrations apply ไม่เคยรัน 0004 เป็นต้นไปเลย
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kit-stock-images"
    }
  ],
  "observability": { "enabled": true }
}
